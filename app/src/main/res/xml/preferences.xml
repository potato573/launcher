<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:app="http://schemas.android.com/apk/res-auto">
    <PreferenceCategory app:title="@string/pref_cat_home" app:iconSpaceReserved="false">
        <ListPreference
            app:key="columns"
            app:title="@string/pref_columns"
            app:entries="@array/columns_entries"
            app:entryValues="@array/columns_entries"
            app:defaultValue="4"
            app:useSimpleSummaryProvider="true"
            app:iconSpaceReserved="false" />
        <SwitchPreferenceCompat
            app:key="show_labels"
            app:title="@string/pref_labels"
            app:defaultValue="true"
            app:iconSpaceReserved="false" />
        <SwitchPreferenceCompat
            app:key="show_dock"
            app:title="@string/pref_dock"
            app:defaultValue="true"
            app:iconSpaceReserved="false" />
        <SwitchPreferenceCompat
            app:key="show_clock"
            app:title="@string/pref_clock"
            app:defaultValue="true"
            app:iconSpaceReserved="false" />
    </PreferenceCategory>
    <PreferenceCategory app:title="@string/pref_cat_drawer" app:iconSpaceReserved="false">
        <SwitchPreferenceCompat
            app:key="auto_keyboard"
            app:title="@string/pref_keyboard"
            app:summary="@string/pref_keyboard_sum"
            app:defaultValue="false"
            app:iconSpaceReserved="false" />
    </PreferenceCategory>
    <PreferenceCategory app:title="@string/pref_cat_general" app:iconSpaceReserved="false">
        <Preference
            app:key="set_default"
            app:title="@string/pref_default"
            app:summary="@string/pref_default_sum"
            app:iconSpaceReserved="false" />
        <Preference
            app:key="reset_layout"
            app:title="@string/pref_reset"
            app:summary="@string/pref_reset_sum"
            app:iconSpaceReserved="false" />
    </PreferenceCategory>
</PreferenceScreen>
